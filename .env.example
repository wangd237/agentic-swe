# OpenAI-compatible LLM provider configuration.
# Copy this file to `.env` and fill the three fields below.
# Never commit `.env` or real API keys.
#
# All OpenAI-compatible providers (DeepSeek / Kimi / GLM / Ollama / ...)
# share these same three variables. Switching providers means editing
# the values here — no policy file changes needed.
#
# Example policies: optimization/policy_versions/llm_*.json

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Common provider reference (uncomment & edit to switch) ---

# DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Kimi / Moonshot:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=kimi-k2-0711-preview

# GLM / Zhipu:
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.5

# Local Ollama / llama.cpp / LM Studio:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5-coder:7b-instruct
# LLM_API_KEY=local
